# Server-side only (read by the Edge Functions / local API). Never prefix these with VITE_.
# Write as KEY=value (no spaces around =) so `supabase secrets set --env-file .env` can read it.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna

# Password for the home page's Refresh button (re-running the agent costs OpenAI credits).
# Checked by the server; also set it in Supabase: supabase secrets set REFRESH_PASSWORD=...
REFRESH_PASSWORD=choose-a-password

# Optional for local dev: lets the local API use the Supabase cache table instead of memory.
# SUPABASE_URL=https://ypdvlkmlkbrgkizobtfk.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...

# Optional: local API port (default 8787).
# API_PORT=8787
