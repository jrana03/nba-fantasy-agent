{
  "name": "nba-fantasy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "deno run --watch --allow-net --allow-env --allow-read --allow-sys --env-file=.env dev/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:functions": "supabase functions deploy nba-home --no-verify-jwt && supabase functions deploy nba-player --no-verify-jwt && supabase functions deploy nba-roster --no-verify-jwt"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.0.1",
    "deno": "^2.5.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4"
  }
}
